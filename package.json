    "dev": "wrangler dev",
    "smoke": "node scripts/smoke-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "htmx.org": "2.0.10",
    "playwright": "1.60.0",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
