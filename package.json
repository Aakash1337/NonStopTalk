{
  "name": "nonstoptalk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=high",
    "check:cloudflare": "wrangler deploy --dry-run --strict --env=",
    "check:cloudflare-staging": "wrangler deploy --dry-run --strict --env staging",
    "check:cloudflare-startup": "wrangler check startup --outfile /tmp/nonstoptalk-worker-startup.cpuprofile",
    "check:cloudflare-types": "wrangler types cloudflare/worker-configuration.d.ts --include-runtime false --check",
    "db:create": "wrangler d1 create nonstoptalk-platform",
    "db:migrate:local": "wrangler d1 migrations apply PLATFORM_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PLATFORM_DB --remote --env=",
    "db:migrate:staging": "wrangler d1 migrations apply PLATFORM_DB --remote --env staging",
    "test:coach": "node --test cloudflare/public/coach-engine.test.js cloudflare/public/coach-loop.test.js cloudflare/public/coach-storage.test.js",
    "test:cloud-progress": "node --test cloudflare/public/cloud-progress.test.js",
    "test:microphone-selection": "node --test cloudflare/public/microphone-selection.test.js",
    "test:setup-kits": "node --test cloudflare/public/setup-kits.test.js",
    "test:admin": "node --test cloudflare/public/admin-analytics.test.js",
    "test:production-monitor": "node --test scripts/production-health-workflow.test.mjs",
    "test:deployment-contract": "node --test scripts/deployment-contract.test.mjs",
    "test:worker-runtime-runner": "node --test scripts/run-worker-vitest.test.mjs",
    "test:smoke-support": "node --test scripts/smoke-process-support.test.mjs",
    "test:staging-outbox-smoke": "node --test scripts/smoke-staging-outbox.test.mjs",
    "test:production-outbox-smoke": "node --test scripts/smoke-production-outbox.test.mjs",
    "test:staging-outbox-rollback-drill": "node --test scripts/drill-staging-outbox-rollback.test.mjs",
    "test:cloudflare": "tsx --test cloudflare/*.test.ts",
    "test:cloudflare-runtime": "tsc -p cloudflare/runtime-tests/tsconfig.json && node scripts/run-worker-vitest.mjs vitest.worker.config.ts",
    "test:cloudflare-runtime-outbox": "tsc -p cloudflare/outbox-runtime-tests/tsconfig.json && node scripts/run-worker-vitest.mjs vitest.outbox.config.ts",
    "types:cloudflare": "wrangler types cloudflare/worker-configuration.d.ts --include-runtime false",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json",
    "deploy": "npm run db:migrate:remote && wrangler deploy --strict --env= && npm run smoke:production",
    "deploy:staging": "npm run db:migrate:staging && wrangler deploy --strict --env staging && npm run smoke:staging",
    "dev": "wrangler dev",
    "smoke": "node scripts/smoke-local.mjs",
    "smoke:accessibility": "node scripts/smoke-accessibility.mjs",
    "smoke:multiplayer": "node scripts/smoke-cloudflare-multiplayer.mjs",
    "smoke:coach": "node scripts/smoke-coach.mjs",
    "smoke:coach-storage": "node scripts/smoke-coach-storage.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:platform": "node scripts/smoke-platform.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:staging": "node scripts/smoke-production.mjs https://nonstoptalk-staging.aakashplays656.workers.dev durable-outbox && node scripts/smoke-staging.mjs https://nonstoptalk-staging.aakashplays656.workers.dev",
    "smoke:staging-outbox": "node scripts/smoke-staging-outbox.mjs",
    "smoke:production-outbox": "node scripts/smoke-production-outbox.mjs",
    "drill:staging-outbox-rollback": "node scripts/drill-staging-outbox-rollback.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@types/node": "24.13.3",
    "htmx.org": "2.0.10",
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true,
    "workerd@1.20260831.1": true
  }
}
